# ─── Copy to .env.local and fill in. Never commit .env.local. ───────────────

# PostgreSQL connection string.
#   Local:  postgresql://user:pass@localhost:5432/license_platform
#   Neon:   the "pooled" connection string from the Neon dashboard, which ends
#           with ?sslmode=require. Use the pooled URL for the app on Vercel.
DATABASE_URL=

# A second, DIRECT (non-pooled) Neon URL, used only by `prisma migrate`.
# On Neon this is the connection string without "-pooler" in the host. Leave
# blank for a local Postgres (Prisma will fall back to DATABASE_URL).
DIRECT_URL=

# 32+ random bytes, base64 or hex. Signs the admin session JWT.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET=

# Server-side HMAC key for hashing licence keys before they touch the database.
# Rotating this invalidates every stored key hash, so set it once and keep it.
# Generate the same way as AUTH_SECRET.
LICENSE_HMAC_SECRET=

# Server-side HMAC key for hashing HWIDs. Same rules as LICENSE_HMAC_SECRET.
HWID_HMAC_SECRET=

# Public base URL of the deployed app, e.g. https://panel.example.com
# Used for absolute links and secure-cookie decisions. http://localhost:3000 in dev.
APP_URL=http://localhost:3000

# Which licence provider new apps default to. MOCK works with no external
# account; KEYAUTH is a future adapter and is not required to run the platform.
LICENSE_PROVIDER=MOCK

# Optional. Server-side only. If set, security/audit events are posted here.
# The browser never sees this value. Leave blank to disable Discord alerts.
DISCORD_WEBHOOK_URL=

# Retention windows in days, read at query/cleanup time so they can change
# without a migration. Defaults are applied in code when unset.
TELEMETRY_RETENTION_DAYS=90
SECURITY_EVENT_RETENTION_DAYS=180
AUDIT_LOG_RETENTION_DAYS=365
